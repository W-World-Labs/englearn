# LingoLearn local environment template.
# scripts/ensure-ready.mjs copies this file to .env.local on the first
# `npm run …` when .env.local is missing. .env.local is gitignored — never
# commit real secrets. All values below are empty placeholders.

# ---- W-ID sign-in (optional locally) ----
# Configure your identity origin, client and signing secret for account records.
# Register an OAuth client at https://identity.example.invalid with redirect:
#   http://localhost:3000/api/auth/callback            (local dev)
#   or ${ENGLEARN_PUBLIC_URL}/api/auth/callback        (deployed)
W_ID_SSO_URL=
W_ID_CLIENT_ID=
W_ID_CLIENT_SECRET=
JWT_SECRET=

# Public origin used for links and the default OAuth redirect URI.
ENGLEARN_PUBLIC_URL=http://localhost:3000
# Optional overrides (defaults shown):
# W_ID_REDIRECT_URI=${ENGLEARN_PUBLIC_URL}/api/auth/callback
# W_ID_BASE_URL is the alternate name for W_ID_SSO_URL.
# W_ID_SCOPES=openid profile email workspace

# ---- Storage ----
# JSON record store directory (default ./data). Production: /var/lib/englearn.
# ENGLEARN_DATA_DIR=./data

# ---- AI scoring for speaking/writing (optional) ----
# anthropic | openai — empty auto-detects Anthropic first, then OpenAI-compatible.
# When nothing is configured, open-response scoring returns "not configured".
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# OpenAI-compatible provider (any /chat/completions service):
OPENAI_API_KEY=
# Base URL including /v1 (default https://api.openai.com/v1)
OPENAI_BASE_URL=
# Model name (default gpt-4o-mini)
OPENAI_MODEL=

# ---- Nitro server (npm start; dev uses vite on :3000) ----
# NITRO_HOST=127.0.0.1
# NITRO_PORT=3010

# ---- Build-time only (deploy pipeline sets these; not needed locally) ----
# VITE_ENGLEARN_RELEASE=<sha12>
# Browser telemetry/feedback is off unless all four build-time settings are set.
# Use your own HTTPS bootstrap and bindings; no credentials in the URL.
# W_RADAR_BOOTSTRAP_URL=https://telemetry.example.invalid/platform/bootstrap.js
# W_RADAR_SDK_CODE=<platform bootstrap code>
# W_RADAR_WORKSPACE_ID=<your workspace>
# W_RADAR_PROJECT_ID=<your project>
